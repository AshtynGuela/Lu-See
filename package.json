{
  "name": "lu-see",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build && node scripts/copy-cesium.mjs",
    "preview": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "data:prepare": "python scripts/prepare_data.py",
    "test:live": "node scripts/validate-live.mjs",
    "test:spice": "node scripts/validate-spice.mjs",
    "test:eclipse": "node scripts/validate-eclipse.mjs",
    "test:eclipse-browser": "node scripts/test-eclipse-browser.mjs",
    "test:solar": "node scripts/validate-solar.mjs",
    "test:solar-browser": "node scripts/test-solar-browser.mjs",
    "data:polar": "python scripts/prepare_polar.py",
    "data:layers": "python scripts/prepare_statistics.py",
    "test:random": "node scripts/validate-random.mjs",
    "test:terrain": "python scripts/validate-terrain.py",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:landing-browser": "node scripts/test-landing-browser.mjs",
    "test:next-window-browser": "node scripts/test-next-window-browser.mjs",
    "test:rocky-motion-browser": "node scripts/test-rocky-motion-browser.mjs",
    "start": "node server/index.mjs --production",
    "test:terrain-remote": "python -m unittest discover -s tests -p \"test_remote*.py\""
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "cesium": "^1.147.0",
    "compression": "^1.8.2",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0"
  }
}
